local fileName = "StableWaypoint_SavedLocations.json"
local savedLocations = {}

local function LoadLocations()
    pcall(function()
        if readfile and pcall(readfile, fileName) then
            local content = readfile(fileName)
            local decoded = HttpService:JSONDecode(content)
            if type(decoded) == "table" then savedLocations = decoded end
        end
    end)
end

local function SaveLocationsToFile()
    pcall(function()
        if writefile then
            writefile(fileName, HttpService:JSONEncode(savedLocations))
        end
    end)
end


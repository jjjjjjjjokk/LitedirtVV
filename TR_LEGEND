local locPage = CreateTab("Locations", "📍 Saved Locations")
CreateCategoryInPage(locPage, "💾 SAVE & SEQUENCE", 11)

CreateButtonInPage(locPage, "SaveLocation", "➕ Save Current Location", function()
    if not humanoidRootPart then return end
    local targetPart = humanoid.SeatPart and (humanoid.SeatPart.AssemblyRootPart or humanoid.SeatPart) or humanoidRootPart
    local pos = targetPart.Position
    table.insert(savedLocations, {x = pos.X, y = pos.Y, z = pos.Z})
    SaveLocationsToFile()
    RefreshLocations()
end, colors.success, 12)

local isAutoTPRunning = false
CreateButtonInPage(locPage, "AutoTPSequence", "▶ Auto TP: 1 to Last Location", function()
    if #savedLocations == 0 then return end
    if isAutoTPRunning then isAutoTPRunning = false return end
    isAutoTPRunning = true
    task.spawn(function()
        for _, loc in ipairs(savedLocations) do
            if not isAutoTPRunning then break end
            ExecuteSafeTeleport(CFrame.new(Vector3.new(loc.x, loc.y, loc.z)), false)
            task.wait(1)
        end
        isAutoTPRunning = false
    end)
end, colors.warning, 13)


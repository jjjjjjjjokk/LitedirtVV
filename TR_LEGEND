local function RefreshWaypointList()
    for _, child in pairs(waypointContainer:GetChildren()) do
        if child ~= waypointLayout then child:Destroy() end
    end
    
    local waypointList = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if string.find(string.lower(obj.Name), "deliverywaypoint") then
            local targetPart = obj:IsA("BasePart") and obj or (obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")))
            if targetPart and not table.find(waypointList, targetPart) then
                table.insert(waypointList, targetPart)
            end
        end
    end
    
    if #waypointList == 0 then
        waypointContainer.Size = UDim2.new(1, 0, 0, 0)
        UpdatePageCanvas(boardListPage)
        return
    end
    
    for idx, part in ipairs(waypointList) do
        local bBtn = Instance.new("TextButton")
        bBtn.Size = UDim2.new(1, -16, 0, 38)
        bBtn.Position = UDim2.new(0, 8, 0, 0)
        bBtn.BackgroundColor3 = colors.bg_light
        bBtn.TextColor3 = colors.text
        bBtn.TextSize = 11
        bBtn.Font = Enum.Font.GothamSemibold
        bBtn.Text = "📌 Waypoint: " .. part.Name
        bBtn.BorderSizePixel = 0
        bBtn.LayoutOrder = idx
        bBtn.Parent = waypointContainer
        Instance.new("UICorner", bBtn).CornerRadius = UDim.new(0, 8)
        
        bBtn.MouseButton1Click:Connect(function()
            -- Menggunakan parameter true agar motor berhenti tepat di depan NPC (tidak menabrak NPC)
            ExecuteSafeTeleport(part.CFrame, true)
        end)
    end
    
    waypointContainer.Size = UDim2.new(1, 0, 0, (#waypointList) * 42)
    UpdatePageCanvas(boardListPage)
end

CreateButtonInPage(boardListPage, "RefreshWaypoints", "🔄 Refresh Waypoint List", function()
    RefreshWaypointList()
end, colors.warning, 11)


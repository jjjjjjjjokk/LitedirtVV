function RefreshLocations()
    for _, child in pairs(savedLocationsContainer:GetChildren()) do
        if child ~= locLayout then child:Destroy() end
    end
    if #savedLocations == 0 then
        savedLocationsContainer.Size = UDim2.new(1, 0, 0, 0)
        UpdatePageCanvas(locPage)
        return
    end
    for idx, loc in ipairs(savedLocations) do
        local locBtn = Instance.new("TextButton")
        locBtn.Size = UDim2.new(1, -16, 0, 38)
        locBtn.Position = UDim2.new(0, 8, 0, 0)
        locBtn.BackgroundColor3 = colors.bg_light
        locBtn.TextColor3 = colors.text
        locBtn.TextSize = 11
        locBtn.Font = Enum.Font.GothamSemibold
        locBtn.Text = string.format("#%d - TP: (%.0f, %.0f, %.0f)", idx, loc.x, loc.y, loc.z)
        locBtn.BorderSizePixel = 0
        locBtn.LayoutOrder = idx
        locBtn.Parent = savedLocationsContainer
        Instance.new("UICorner", locBtn).CornerRadius = UDim.new(0, 8)
        
        locBtn.MouseButton1Click:Connect(function()
            ExecuteSafeTeleport(CFrame.new(Vector3.new(loc.x, loc.y, loc.z)), false)
        end)
        
        local delBtn = Instance.new("TextButton")
        delBtn.Size = UDim2.new(0, 26, 0, 26)
        delBtn.Position = UDim2.new(1, -34, 0.5, -13)
        delBtn.BackgroundColor3 = colors.accent
        delBtn.TextColor3 = colors.text
        delBtn.TextSize = 12
        delBtn.Font = Enum.Font.GothamBold
        delBtn.Text = "×"
        delBtn.BorderSizePixel = 0
        delBtn.Parent = locBtn
        Instance.new("UICorner", delBtn).CornerRadius = UDim.new(0, 6)
        
        delBtn.MouseButton1Click:Connect(function()
            table.remove(savedLocations, idx)
            SaveLocationsToFile()
            RefreshLocations()
        end)
    end
    savedLocationsContainer.Size = UDim2.new(1, 0, 0, (#savedLocations + 1) * 42)
    UpdatePageCanvas(locPage)
end
RefreshLocations()

